# ALBEDO_ALLOW_MUTABLE_REF=false
# ALBEDO_FASTDL_CONNECTIONS=64
# ALBEDO_DOWNLOAD_STALL_SECONDS=180
# ALBEDO_DOWNLOAD_STALL_RETRIES=5
# ALBEDO_OPENSEARCH_URL=url
# ALBEDO_OPENSEARCH_INDEX=albedo_fingerprints
